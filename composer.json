{
    "name": "geekish/faker-providers",
    "description": "Extra providers for Faker",
    "keywords": [
        "geekish",
        "faker",
        "faker-providers"
    ],
    "homepage": "https://github.com/geekish/faker-providers",
    "license": "MIT",
    "authors": [
        {
            "name": "Hannah Chartier",
            "email": "hannah@sent.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "fakerphp/faker": "^1.9",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Geekish\\FakerProviders\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Geekish\\FakerProviders\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
